
type fixedSourcePhysicsPackage;
//type eigenPhysicsPackage;
pop 100000;


// Fixed source
cycles   100;

XSdata   ce;
dataType h;
seed 42;
outputFormat asciiJSON;
outputFile ../output/150MeV_2d_dx005;

collisionOperator { protonCE {type protonCEstd; minEnergy 1; maxEnergy 200;} 
                  }

transportOperator { type transportOperatorSBM; minEnergy 1; maxEnergy 200; dx 0.05;
                  }

source {
  type pointSource;
  r (0 0 0);
  rStd 0.05;
  rNozzle 0.05;
  dir (1 0 0);
  particle proton;
  E 150.0;
}

tally { 
  pE {type protonEnergyClerk; 
      map {type spaceMap; axis z; grid lin; min 0; max 20; N 400;}}
  pExy {type protonEnergyClerk; 
      map {type multiMap; maps ( mapX mapY );
        mapX {type spaceMap; axis x; grid lin; min 0; max 20; N 200;}
        mapY {type spaceMap; axis y; grid lin; min -5; max 5; N 200;}
        }
      }
}


geometry {
    type geometryStd;
    boundary (0 0 1 1 1 1);
    graph {type shrunk;}

    surfaces
    {
      squareBound { id 1; type box; origin ( 25.0  0.0  0.0); halfwidth (25.0 50.0 50.0); }
    }


    cells
    {
    }

    universes
    {

      root
      {
          id 1;
          type rootUniverse;
          border 1;
          fill fuel;
      }
    }
}

nuclearData {

  handles {
     ce { type aceProtonDatabase; aceLibrary $SCONE_ACE;}
  }


materials {

    fuel {
      temp       273;
      excitationEnergy 0.000075;
      composition {
         1001.25    6.700E-002;
         8016.25    3.350E-002;
      }
    }

}

}



